{
  "expo": {
    "name": "MamaCare",
    "slug": "mamacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mamacare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.mamacare.reminder" },
    "android": {
      "package": "com.mamacare.reminder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAF9F4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#FEFEFC", "image": "./assets/mamacare-logo-official.png", "imageWidth": 300, "resizeMode": "contain" }],
      "expo-sqlite",
      ["expo-notifications", { "defaultChannel": "vitamin-reminders" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
